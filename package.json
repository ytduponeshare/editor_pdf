{
  "name": "editor_pdf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:java": "mvn -f java-backend/pom.xml compile exec:java",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:java\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:roles": "tsx scripts/test-roles.ts",
    "test:field-tables": "tsx scripts/test-field-tables.ts",
    "test:html-template": "tsx scripts/test-html-template.ts",
    "test:java": "mvn -f java-backend/pom.xml test",
    "test:pdf": "bash java-backend/smoke-test.sh"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "dompurify": "3.2.6",
    "react": "17.0.1",
    "react-dom": "17.0.1"
  },
  "devDependencies": {
    "@types/react": "17.0.38",
    "@types/react-dom": "17.0.11",
    "@vitejs/plugin-react": "1.3.2",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "4.5.2",
    "vite": "2.9.18",
    "jsdom": "^20.0.3"
  }
}
