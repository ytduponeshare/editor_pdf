    "fieldTables": [
      {
        "tableId": "dynamic-long-table",
        "config": {
          "version": 1,
          "mode": "list",
          "sourceId": "long-contract-items",
          "rows": 1,
          "columns": [
            {
              "id": "code",
              "title": "明细编码",
              "type": "text",
              "binding": {
                "kind": "current",
                "sourceId": "long-contract-items",
                "fieldId": "code"
