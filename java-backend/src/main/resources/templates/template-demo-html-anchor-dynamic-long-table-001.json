          "record": 1
        }
      },
      {
        "id": "dynamic-status-template",
        "name": "状态",
        "type": "text",
        "binding": {
          "version": 1,
          "sourceId": "long-contract-items",
          "fieldId": "status",
          "type": "text",
          "sourceName": "动态超高协议明细",
          "fieldName": "状态",
          "kind": "record",
          "record": 1
        }
