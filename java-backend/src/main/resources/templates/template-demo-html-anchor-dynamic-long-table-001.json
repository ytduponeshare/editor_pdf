    ],
    "fields": [
      {
        "id": "dynamic-name-party-a",
        "name": "甲方姓名",
        "type": "text",
        "roleId": "party-a",
        "binding": {
          "version": 1,
          "sourceId": "system",
          "fieldId": "name",
          "type": "text",
          "sourceName": "系统字段",
          "fieldName": "姓名",
          "kind": "category",
          "inputType": "text"
        }
      },
      {
        "id": "dynamic-signature-party-a",
        "name": "甲方签名",
        "type": "signature",
        "roleId": "party-a"
      },
      {
        "id": "dynamic-seal-party-a",
        "name": "甲方企业章",
        "type": "companySeal",
        "roleId": "party-a"
      },
      {
        "id": "dynamic-name-party-b",
        "name": "乙方姓名",
        "type": "text",
        "roleId": "party-b",
        "binding": {
          "version": 1,
          "sourceId": "system",
          "fieldId": "name",
          "type": "text",
          "sourceName": "系统字段",
          "fieldName": "姓名",
          "kind": "category",
          "inputType": "text"
        }
      },
      {
        "id": "dynamic-signature-party-b",
        "name": "乙方签名",
        "type": "signature",
        "roleId": "party-b"
      },
      {
        "id": "dynamic-code-template",
        "name": "明细编码",
        "type": "text",
        "binding": {
          "version": 1,
          "sourceId": "long-contract-items",
          "fieldId": "code",
          "type": "text",
          "sourceName": "动态超高协议明细",
          "fieldName": "明细编码",
          "kind": "record",
          "record": 1
        }
      },
      {
        "id": "dynamic-description-template",
        "name": "协议说明",
        "type": "text",
        "binding": {
          "version": 1,
          "sourceId": "long-contract-items",
          "fieldId": "description",
          "type": "text",
          "sourceName": "动态超高协议明细",
          "fieldName": "协议说明",
